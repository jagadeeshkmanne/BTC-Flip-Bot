//@version=6
// ─────────────────────────────────────────────────────────────────────
// S/R DCA Day Trader (5m) — V2.1 (RSI divergence + BE-stop + 2% SL)
//
// V2.1 = V2's RSI divergence entry + V1's BE-stop concept tuned for the
// new entry quality. Live on GCP testnet bot since 2026-05-06.
//
// What V2.1 changes vs V2 (2026-05-06):
//   - SL below worst entry: 1.4% → 2.0% (BE-stop now rescues borderline
//     trades that would have noise-stopped at 1.4%)
//   - Breakeven SL: OFF → ON (1.0% trigger / 0.25% buffer) — V2 testing
//     said BE was redundant with divergence, but Mar 30–May 6 data showed
//     it adds clean +1.3% return + +2.0 PF when paired with 2.0% SL.
//
// What V2 added vs V1 (still in V2.1):
//   - RSI divergence at S/R touch (DEFAULT ON, pivot 5/5, fresh 20 bars)
//   - RSI anti-extreme filter (DEFAULT OFF — divergence subsumes it)
//   - Volume × 20-bar avg lowered 1.2 → 1.1 (slightly more permissive)
//   - DCA spacing 0.8% → 0.85%
//
// ⚠ DESIGNED FOR: BTCUSDT · 5-minute timeframe · ONLY.
//
// Logic (V2):
//   - Entry: 5m low touches prev_L (LONG) or 5m high touches prev_H (SHORT)
//     within a 0.05% zone, AND a fresh RSI divergence pivot was confirmed
//     within the last 20 bars (DEFAULT). Adaptive S/R: when prev-day range
//     < floor, expand lookback to N-day rolling H/L until range ≥ floor.
//   - Filters: volume ≥ 1.1× SMA. RSI anti-extreme available but OFF by default.
//   - RSI divergence: bearish for shorts at prev_H, bullish for longs at prev_L.
//   - DCA: 1 add at worst_entry × (1 ∓ 0.8%)
//   - TP: hybrid — prev_mid pre-DCA, switches to first_entry × (1 ∓ 4%) post-DCA
//   - SL: worst_entry × (1 ∓ 1.9%) — moves with each DCA leg
//   - BE-stop available but OFF by default (was ON in V1)
//   - EOD: force flatten at configurable UTC hour (default 20:00)
//
// Backtest history (BTCUSDT 5m):
//   Mar 30 – May 6:
//     - V2.1 (DEFAULT, hybrid TP, BE ON, SL 2.0):                       +28.31% / PF 12.41 / DD 2.56% / 26 trades / WR 76.92%
//     - V2 (hybrid TP, BE off, SL 1.4) on same window (estimate):       ~+24.65% / PF ~7.3
//     - fixed_pct + BE on + trail @ 2% post-DCA:                        +24.75% / PF 9.66  / DD 2.56% / 25 trades / WR 76%
//     - fixed_pct + BE on + no trail:                                   +23.95% / PF 7.73  / DD 2.64% / 25 trades / WR 68%
//   Mar 30 – May 4:
//     - V2 minimal config (divergence ON, RSI off, BE off, vol 1.1):    +25.44% / PF 7.38  / DD 2.69% / 23 trades / WR 69.6%
//     - V1 baseline (no divergence):                                    +25.18% / PF 3.27  / DD 4.61% / 43 trades / WR 60.5%
//   Mar 23 – May 3 (larger window):
//     - V1 (no divergence):                                             +43.18% / PF 4.42  / DD 4.61% / 47 trades / WR 66%
// Multi-RSI variants (fast 7 / slow 21) tested and rejected: noise on fast,
// stale on slow. Standard RSI(14) at 5/5/20 is the validated config.
// Post-DCA trail and full trail tested and rejected: BE-stop already provides
// the same protection cleaner.
//
// ⚠ Regime warning: a 2.3-year python backtest returned -72.78% / DD 82%.
// The strategy is regime-favorable (works in mean-reverting markets) but
// breaks down in strong trends. Paper-trade or testnet first.
//
// Live testnet deployment: http://34.14.124.215:8888/dashboard.html?env=testnet
// ─────────────────────────────────────────────────────────────────────

leverageInput = input.float(2.0, "Leverage cap", minval=1, maxval=10, step=0.5)

strategy("S/R DCA Day Trader (5m) V2 — divergence", overlay=true, initial_capital=5000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=95,
     pyramiding=3, calc_on_order_fills=false, calc_on_every_tick=false,
     process_orders_on_close=true, commission_type=strategy.commission.percent,
     commission_value=0.04, slippage=3,
     margin_long=0, margin_short=0)

// ─── Risk ───
grpRisk = "⚙️ Risk"
riskPct = input.float(6.0, "Total risk per cycle (%)", minval=0.1, maxval=15, step=0.5, group=grpRisk,
     tooltip="At 6% the TV 5-week test gave +14.07% / 9.75% DD. Drop to 5% for safer, raise to 8% for aggressive.") / 100

// ─── DCA ───
grpDCA = "📊 S/R DCA"
dcaLevels    = input.int(2, "DCA levels", minval=1, maxval=5, group=grpDCA,
     tooltip="5m uses 2 levels. Each DCA adds 1 leg at worst_entry × (1 ± dcaSpacing).")
dcaSpacing   = input.float(0.85, "DCA spacing (%)", minval=0.3, maxval=3, step=0.05, group=grpDCA,
     tooltip="V2 DEFAULT 0.85 (V1 was 0.8). Tested better paired with the tighter 1.4% SL — gives DCA leg a hair more breathing room before SL distance shortens past it.") / 100
slBelowWorst = input.float(2.0, "SL below worst entry (%)", minval=0.5, maxval=5, step=0.1, group=grpDCA,
     tooltip="V2.1 DEFAULT 2.0 (was 1.4). With BE-stop ON, looser SL outperforms tight — BE rescues trades that would have noise-stopped at 1.4%. Tested Mar 30–May 6: 2.0% gives +28.31% / PF 12.41 vs 1.4% +27.02% / PF 10.45.") / 100
supportZone  = input.float(0.05, "S/R entry zone (%)", minval=0.05, maxval=1, step=0.05, group=grpDCA,
     tooltip="How close to prev_H/prev_L the bar high/low must be to count as a touch. 0.05% = direct touch only, very selective. Wider zones fire on near-misses but hurt win rate.") / 100
useEodFlatten = input.bool(true, "Force flatten at EOD UTC hour", group=grpDCA,
     tooltip="When ON: position closes at closeHour UTC and entries are blocked past that hour. When OFF: position rides until TP or SL hits, no time limit. Backtest history says EOD-on is safer; OFF lets winners run but exposes to overnight regime shifts.")
closeHour    = input.int(20, "Force flatten at UTC hour", minval=12, maxval=23, group=grpDCA,
     tooltip="Only used when EOD flatten is ON. Backtest: 20 is conservative, 23 lets trades work longer.")

// ─── Multi-cycle (opt-in) ───
grpReentry = "🔁 Multi-cycle"
maxCyclesPerDay = input.int(1, "Max cycles per UTC day", minval=1, maxval=5, group=grpReentry,
     tooltip="1 (DEFAULT, matches +40.59% baseline): one entry/exit cycle per UTC day. >1: after exit (TP or SL), allow re-entry on a fresh prev_H/prev_L touch — same conditions, no special re-entry logic — up to N cycles. EOD flatten always closes the day. With extend mode active, prev_H/prev_L are the WIDER multi-day band, so re-touches within the same day are rare but each cycle re-exposes the full SL — one trend day costs N×SL.")

// ─── Quality filters ───
grpFilter = "🎯 Entry Quality Filters"
useVolumeFilter  = input.bool(true, "Require volume confirmation at entry", group=grpFilter)
volMult          = input.float(1.1, "Volume × 20-bar avg", minval=0.5, maxval=3.0, step=0.1, group=grpFilter,
     tooltip="V2 DEFAULT 1.1 (was 1.2 in V1). With divergence ON, volume filter is mostly redundant; 1.1 lets a few more high-quality entries through that 1.2 was blocking.")

// RSI filter — anti-extreme protection:
//   Skip LONG if RSI < 25 (don't catch falling knives)
//   Skip SHORT if RSI > 75 (don't catch flying knives)
// Inverted logic (require extremes) was tested and rejected — backtest worse.
// V2: default OFF — divergence subsumes this. Filter caught knives BEFORE
// divergence existed; with divergence ON, both filters reject the same
// entries → vol+RSI is no-op overhead. Tested Mar 30–May 4: identical
// return at slightly lower DD with this OFF.
useRsiFilter     = input.bool(false, "Skip extreme RSI (falling/flying knives)", group=grpFilter)
rsiPeriod        = input.int(14, "RSI period", minval=5, maxval=30, step=1, group=grpFilter,
     tooltip="14 = 70-min lookback on 5m. Standard.")
rsiLow           = input.float(25.0, "Skip long if RSI <", minval=10, maxval=40, step=1, group=grpFilter)
rsiHigh          = input.float(75.0, "Skip short if RSI >", minval=60, maxval=90, step=1, group=grpFilter)

useCloseConfirm = false  // close confirm — kept off in user's tested config

// ─── RSI Divergence (DEFAULT ON — proven on 5w window) ───
// At the prev_H / prev_L touch where we'd normally enter, require a recent
// momentum divergence as confirmation that the move is exhausting:
//   - SHORT at prev_H: bearish divergence (price HH, RSI LH) → upside weakening
//   - LONG  at prev_L: bullish divergence (price LL, RSI HL) → downside weakening
// Mar 30 – May 4: +25.38% / DD 2.91% / 25 trades / WR 72% / PF 7.39 — strictly
// better risk-adjusted than the no-div baseline (+25.18% / DD 4.61% / 43 trades).
// Multi-RSI variants (fast 7 / slow 21) tested and rejected: trade count
// dropped, DD worsened — fast RSI fired on noise, slow on stale moves.
// 5/5/20 with standard RSI(14) is the validated config.
grpDiv = "📉 RSI Divergence"
useRsiDivergence = input.bool(true, "Require RSI divergence at S/R", group=grpDiv,
     tooltip="DEFAULT ON. Only fires L1 entry if a fresh divergence pivot was confirmed within divFreshBars. Bearish for shorts at prev_H; bullish for longs at prev_L. Filter cuts trade count ~45% but PF more than doubles and DD halves — the highest-EV edit on the 5w window.")
divPivotL    = input.int(5, "Pivot left bars",  minval=1, maxval=10, group=grpDiv,
     tooltip="Bars on the left of the pivot that must be lower (for highs) / higher (for lows) for it to count. 5 (DEFAULT) catches real swing turning points; 3 catches noise.")
divPivotR    = input.int(5, "Pivot right bars", minval=1, maxval=10, group=grpDiv,
     tooltip="Bars on the right that confirm the pivot. 5 (DEFAULT) = 25 min lag. Lower (3) confirms faster but pivots can fail to fully form. Tested: 5 best on 5w window.")
divFreshBars = input.int(20, "Divergence valid for N bars", minval=1, maxval=50, group=grpDiv,
     tooltip="How long after a divergence pivot fires the signal stays usable. 20 (DEFAULT) = ~100 min on 5m. 10 was too tight (lots of misses); 50 added stale entries that hurt DD with no return upside.")

// ─── Adaptive S/R range ───
// Problem this fixes: when prev_day range is tight (e.g., 1% squeeze day),
// prev_mid TP target is only ~0.5% from entry while SL is 2% — R:R 0.25,
// need 80% WR just to break even. Live data (Apr 26 → May 3) confirmed it:
// every losing/break-even trade had prev_range < 2.5%.
// Modes:
//   - off    : always use prev_day H/L (BASELINE, +32% on 5w window).
//   - skip   : gate entries when prev_day range < floor — sit out on tight days.
//   - extend : when prev_day range < floor, expand to N-day rolling H/L until
//              range ≥ floor. Wider band → entries fire at the wider levels and
//              prev_mid TP shifts further → bigger wins, fewer signals.
grpRange = "📏 Adaptive S/R range"
rangeFilterMode = input.string("extend", "Range filter mode", options=["off", "skip", "extend"], group=grpRange,
     tooltip="extend (DEFAULT, +40.59% Mar 23–May 3 paired with hybrid TP): when prev_day range < floor, expand lookback to N days until rolling H/L band ≥ floor; entries fire at wider levels and TP shifts to wider prev_mid. off: always use prev_day H/L (legacy baseline +32% on Mar 23–May 1). skip: gate entries when prev_day range < floor — sit out tight days entirely.")
minPrevRangePct = input.float(2.0, "Min prev range (%)", minval=0.5, maxval=5.0, step=0.1, group=grpRange,
     tooltip="Range floor. With default 2% SL: 2% range → R:R ~0.5 (break-even at 67% WR); 3% range → R:R ~0.75 (break-even at 58%). Lower = more trades, worse R:R; higher = pickier, better R:R.") / 100
maxLookbackDays = input.int(2, "Max lookback days (extend mode)", minval=2, maxval=10, group=grpRange,
     tooltip="Used in extend mode only. Cap on how far back to expand the rolling H/L window. 2 (DEFAULT) tested best on the 5w window — going to 3-5 left more days unfiltered (range still under floor with only 2 days). If even N-day range stays below floor, the widest available is used anyway.")

// ─── Take Profit ───
grpTP = "🎯 Take Profit"
tpMode = input.string("hybrid", "TP target", options=["prev_mid", "hybrid", "smart", "prev_extreme", "fixed_pct"], group=grpTP,
     tooltip="hybrid (DEFAULT, +40.59% paired with extend 2d on Mar 23–May 3) = prev_mid pre-DCA, then switches to FIRST entry × (1 ∓ tpFixedPct=4%) once DCA fires (worse-avg trades ride further). prev_mid (legacy baseline, +32.07% on Mar 23–May 1) = yesterday's midpoint, fixed S/R anchor. smart = whichever of {prev_mid, avg × (1 ∓ smartPct)} is CLOSER to mark — adapts to slippage but takes profit earlier. prev_extreme = full prev_day range (riskier). fixed_pct = N% from FIRST entry, no prev_mid blend.")
smartTpPct = input.float(0.5, "Smart TP: % from avg entry", minval=0.1, maxval=3.0, step=0.1, group=grpTP,
     tooltip="Used in smart mode only. After each DCA leg fills, TP recomputes to avg_entry × (1 ∓ this%). Smaller % = earlier TP, smaller wins. 0.5% scalp tested at +20% / 5w — worse than prev_mid. Try 1.0–1.5% if you want a middle ground.") / 100
tpFixedPct = input.float(4.0, "Fixed TP distance from entry (%)", minval=0.1, maxval=10, step=0.1, group=grpTP,
     tooltip="Used when TP mode = fixed_pct. 4% works on recent 5w TV. ⚠ 2.3y backtest of fixed TP all variants = -71% to -79% — regime-favorable only.") / 100
prevMidOffsetPct = input.float(0.1, "Prev_mid TP offset (%)", minval=-1.0, maxval=1.0, step=0.05, group=grpTP,
     tooltip="Shift the prev_mid TP slightly toward current price for more reliable fills (prev_mid often sits at a thin-liquidity zone where exact-fill is unreliable). 0.1% = TP fires 0.1% before exact mid → smaller wins but higher hit rate. Negative offset = wait past mid for bigger wins (riskier — may miss fill entirely). Set to 0 for exact prev_mid behavior.") / 100

// (Trailing stop tested and removed — too many false trail-outs near peaks.)

// ─── Breakeven SL (opt-in) ───
// Pattern this fixes: with hybrid TP at 4% post-DCA, trades that hit +1.5–2.7%
// favorable but reverse before TP ended -1.1% / -0.3% / +0.1%. Breakeven SL
// locks in the runup once favorable crosses a threshold, converting these
// "almost wins" into small wins.
//   ⚠ Earlier note in header said BE was tested and rejected, but that was
//   on the OLD config (range_off / prev_mid TP) where targets were tighter
//   so less runup to give back. With hybrid 4% TP, BE has more to add.
grpBE = "🛡️ Breakeven SL"
useBreakeven = input.bool(true, "Enable breakeven SL after favorable threshold", group=grpBE,
     tooltip="V2.1 DEFAULT ON. Locks in profit when fav% > 1% from first entry → SL tightens to entry × (1 ± 0.25%). With looser 2.0% SL, BE provides the second protection layer that rescues trades hitting +1% favorable then reversing. Tested Mar 30–May 6 with hybrid TP: BE ON gives +28.31% / PF 12.41; BE OFF gives +24.75% / PF 7.73.")
breakevenTriggerPct = input.float(1.0, "BE trigger: favorable % from first entry", minval=0.3, maxval=3.0, step=0.1, group=grpBE,
     tooltip="Once price moves this far in our favor (vs first entry), SL tightens to entry ± buffer. 1.0% (DEFAULT) = aggressive lock-in (proven on 5w window). 1.5% = patient (fewer BE-stops, lets winners breathe).") / 100
breakevenBufferPct = input.float(0.25, "BE buffer above/below entry (%)", minval=0.0, maxval=0.5, step=0.05, group=grpBE,
     tooltip="Tighten SL to firstEntry × (1 ± this%). 0.25% (DEFAULT) covers ~2× Binance taker fee (0.04%×2) + slippage cushion → locks in real ~0.20% net profit. 0.1% is barely above breakeven; 0% = exact entry (loses to fees).") / 100

// ─── Post-DCA trail stop (opt-in, EXPERIMENT) ───
// Pattern this fixes: post-DCA trades that drift back near avg entry but
// don't reach the far hybrid TP (-4% from first_entry). Yesterday's
// 2026-05-05 SHORT was an example: avg $81,213, drifted in $81,400-$81,500
// range all afternoon, exited EOD at -0.79%. A trail behind the post-DCA
// best favorable price could have caught the partial recovery.
//
// Activates ONLY after DCA fires (filledCount > 1). Tracks the best-
// favorable price since DCA fill; SL trails behind it by trailOffsetPct,
// monotonically. Pre-DCA trades use the regular hybrid/prev_mid TP.
//
// Earlier full trail-stop test was rejected — it stopped winners short.
// Limiting to post-DCA only avoids that issue (winners that work pre-DCA
// hit prev_mid TP before DCA ever fires).
grpPostTrail = "📈 Post-DCA Trail Stop"
usePostDcaTrail = input.bool(false, "Trail SL after DCA fires", group=grpPostTrail,
     tooltip="When ON: after DCA fills, track the best-favorable price seen and tighten SL to that price ± trailOffset. Captures partial recoveries that don't reach the post-DCA hybrid TP. Default OFF — backtest before enabling.")
postDcaTrailOffset = input.float(0.5, "Trail offset behind peak (%)", minval=0.1, maxval=2.0, step=0.05, group=grpPostTrail,
     tooltip="SL trails the best favorable price by this %. 0.5% (DEFAULT) — observed avg EOD giveback in 5w trade history. Smaller = locks in more but stops sooner; larger = breathes more.") / 100

// ─── Prior day levels (with optional range-floor fallback) ───
// Pre-fetch rolling N-day H/L offsets (1..5). Pine evaluates all
// request.security calls regardless of branch, but they're cheap and we
// only USE the lookback the cascade picks. Each is shifted by [1] so the
// current day's bars never leak in (no lookahead).
prevH1 = request.security(syminfo.tickerid, "1D", high[1], lookahead=barmerge.lookahead_off)
prevL1 = request.security(syminfo.tickerid, "1D", low[1],  lookahead=barmerge.lookahead_off)
prevH2 = request.security(syminfo.tickerid, "1D", ta.highest(high, 2)[1], lookahead=barmerge.lookahead_off)
prevL2 = request.security(syminfo.tickerid, "1D", ta.lowest(low,  2)[1],  lookahead=barmerge.lookahead_off)
prevH3 = request.security(syminfo.tickerid, "1D", ta.highest(high, 3)[1], lookahead=barmerge.lookahead_off)
prevL3 = request.security(syminfo.tickerid, "1D", ta.lowest(low,  3)[1],  lookahead=barmerge.lookahead_off)
prevH4 = request.security(syminfo.tickerid, "1D", ta.highest(high, 4)[1], lookahead=barmerge.lookahead_off)
prevL4 = request.security(syminfo.tickerid, "1D", ta.lowest(low,  4)[1],  lookahead=barmerge.lookahead_off)
prevH5 = request.security(syminfo.tickerid, "1D", ta.highest(high, 5)[1], lookahead=barmerge.lookahead_off)
prevL5 = request.security(syminfo.tickerid, "1D", ta.lowest(low,  5)[1],  lookahead=barmerge.lookahead_off)

// Default = 1-day (matches baseline). In extend mode, walk the cascade
// 1→5 and stop at the first lookback whose range meets the floor (or the
// max-lookback cap, whichever comes first).
prevH = prevH1
prevL = prevL1
activeLookback = 1
if rangeFilterMode == "extend"
    if (prevH1 - prevL1) / prevL1 < minPrevRangePct and maxLookbackDays >= 2
        prevH := prevH2
        prevL := prevL2
        activeLookback := 2
        if (prevH2 - prevL2) / prevL2 < minPrevRangePct and maxLookbackDays >= 3
            prevH := prevH3
            prevL := prevL3
            activeLookback := 3
            if (prevH3 - prevL3) / prevL3 < minPrevRangePct and maxLookbackDays >= 4
                prevH := prevH4
                prevL := prevL4
                activeLookback := 4
                if (prevH4 - prevL4) / prevL4 < minPrevRangePct and maxLookbackDays >= 5
                    prevH := prevH5
                    prevL := prevL5
                    activeLookback := 5
prevMid = (prevH + prevL) / 2.0

// 1h EMA — chart display only. The strategy doesn't gate entries on bias;
// shown for visual context (bias filter was tested and removed — it blocked
// 60%+ of valid entries because bias flips bear right when price reaches prev_L).
hourEmaLen = 20
hourEma    = request.security(syminfo.tickerid, "60", ta.ema(close, hourEmaLen)[1], lookahead=barmerge.lookahead_off)

// ─── Time ───
utcH = hour(time, "UTC")
newDay = ta.change(dayofmonth) != 0

// ─── Filter computations ───
volAvg = ta.sma(volume, 20)
volOk = not useVolumeFilter or volume >= volMult * volAvg

rsiVal = ta.rsi(close, rsiPeriod)
// Anti-extreme: skip LONG when oversold, skip SHORT when overbought
rsiOkLong  = not useRsiFilter or rsiVal >= rsiLow
rsiOkShort = not useRsiFilter or rsiVal <= rsiHigh

// ─── RSI Divergence detection ───
// Track last 2 confirmed price-pivots (hi/lo) and the RSI value AT that pivot
// bar (which is divPivotR bars behind the confirmation bar). Bearish div =
// price made a higher high while RSI made a lower high. Bullish = opposite.
priceHiPivot = ta.pivothigh(high, divPivotL, divPivotR)
priceLoPivot = ta.pivotlow(low,  divPivotL, divPivotR)

var float lastPHigh = na
var float prevPHigh = na
var float lastRAtH  = na
var float prevRAtH  = na
var float lastPLow  = na
var float prevPLow  = na
var float lastRAtL  = na
var float prevRAtL  = na

if not na(priceHiPivot)
    prevPHigh := lastPHigh
    prevRAtH  := lastRAtH
    lastPHigh := priceHiPivot
    lastRAtH  := rsiVal[divPivotR]

if not na(priceLoPivot)
    prevPLow := lastPLow
    prevRAtL := lastRAtL
    lastPLow := priceLoPivot
    lastRAtL := rsiVal[divPivotR]

bearishDivFired = not na(prevPHigh) and not na(priceHiPivot) and lastPHigh > prevPHigh and lastRAtH < prevRAtH
bullishDivFired = not na(prevPLow)  and not na(priceLoPivot) and lastPLow  < prevPLow  and lastRAtL > prevRAtL

// Bars-since-fire trackers — divergence stays "fresh" for divFreshBars
var int barsSinceBearDiv = 9999
var int barsSinceBullDiv = 9999
barsSinceBearDiv := bearishDivFired ? 0 : barsSinceBearDiv + 1
barsSinceBullDiv := bullishDivFired ? 0 : barsSinceBullDiv + 1

bearDivOk = not useRsiDivergence or barsSinceBearDiv <= divFreshBars
bullDivOk = not useRsiDivergence or barsSinceBullDiv <= divFreshBars

// Range gate. In skip mode, block entries when active range < floor.
// In off/extend mode, the cascade above has already picked the widest
// usable band, so the gate passes (entries fire, possibly fewer of them).
prevRangePct = (prevH - prevL) / prevL
rangeOk = rangeFilterMode != "skip" or prevRangePct >= minPrevRangePct

// Optional close confirmation
closeOkLong  = not useCloseConfirm or close > open
closeOkShort = not useCloseConfirm or close < open

// ─── State ───
var int   filledCount = 0
var float firstEntryPx = na
var float worstEntryPx = na
// Weighted avg entry tracking — needed for "smart" TP mode that recomputes
// the target after each DCA fill. cumNotional / cumQty = avgEntryPx.
var float cumNotional = na
var float cumQty      = na
avgEntryPx = na(cumQty) or cumQty == 0 ? na : cumNotional / cumQty
var int   cycleClosedOnDay = -1
var int   cyclesToday = 0
var bool  beActivated = false
// Post-DCA trail state — peakFavPx tracks best (lowest for short / highest
// for long) price since DCA fired. Reset when cycle ends.
var float peakFavPx = na

if newDay
    cycleClosedOnDay := -1
    cyclesToday := 0

cycleDone = cycleClosedOnDay == dayofmonth

// ─── Per-level sizing ───
// Total risk = riskPct of equity; worst-case SL distance from L1 = (N-1)*spacing + slBelow
worstSlDistPct = (dcaLevels - 1) * dcaSpacing + slBelowWorst
totalNotional = strategy.equity * 0.95 * riskPct / worstSlDistPct
perLevelQty = totalNotional / close / dcaLevels
qtyCap = (strategy.equity * 0.95 * leverageInput) / close / dcaLevels
perLevelQty := math.min(perLevelQty, qtyCap)

// ─── L1 entry: touch prev_L (for longs) or prev_H (for shorts) ───
// NO BIAS CHECK. LONG and SHORT both allowed regardless of trend.
inEntryWindow = not useEodFlatten or utcH < closeHour
l1LongOk = not cycleDone and strategy.position_size == 0 and inEntryWindow
     and low <= prevL * (1 + supportZone) and low > prevL * (1 - 0.01)
     and volOk and rsiOkLong
     and rangeOk and closeOkLong
     and bullDivOk

l1ShortOk = not cycleDone and strategy.position_size == 0 and inEntryWindow
     and high >= prevH * (1 - supportZone) and high < prevH * (1 + 0.01)
     and volOk and rsiOkShort
     and rangeOk and closeOkShort
     and bearDivOk

if l1LongOk and perLevelQty > 0
    entryPx = prevL * (1 + supportZone / 2)
    strategy.entry("L1", strategy.long, qty=perLevelQty, limit=entryPx)
    firstEntryPx := entryPx
    worstEntryPx := entryPx
    cumNotional  := entryPx * perLevelQty
    cumQty       := perLevelQty
    filledCount  := 1

if l1ShortOk and perLevelQty > 0
    entryPx = prevH * (1 - supportZone / 2)
    strategy.entry("S1", strategy.short, qty=perLevelQty, limit=entryPx)
    firstEntryPx := entryPx
    worstEntryPx := entryPx
    cumNotional  := entryPx * perLevelQty
    cumQty       := perLevelQty
    filledCount  := 1

// ─── DCA: add next level when price moves spacing% against us ───
if strategy.position_size > 0 and filledCount >= 1 and filledCount < dcaLevels
    nextDcaPx = worstEntryPx * (1 - dcaSpacing)
    if low <= nextDcaPx
        idStr = "L" + str.tostring(filledCount + 1)
        strategy.entry(idStr, strategy.long, qty=perLevelQty, limit=nextDcaPx)
        worstEntryPx := nextDcaPx
        cumNotional  := cumNotional + nextDcaPx * perLevelQty
        cumQty       := cumQty + perLevelQty
        filledCount  := filledCount + 1

if strategy.position_size < 0 and filledCount >= 1 and filledCount < dcaLevels
    nextDcaPx = worstEntryPx * (1 + dcaSpacing)
    if high >= nextDcaPx
        idStr = "S" + str.tostring(filledCount + 1)
        strategy.entry(idStr, strategy.short, qty=perLevelQty, limit=nextDcaPx)
        worstEntryPx := nextDcaPx
        cumNotional  := cumNotional + nextDcaPx * perLevelQty
        cumQty       := cumQty + perLevelQty
        filledCount  := filledCount + 1

// ─── TP + SL (static SL, configurable TP) ───
// prev_mid offsets: shift target slightly toward current price for fill reliability.
// LONG TP is above current → lower it slightly; SHORT TP is below current → raise it.
prevMidLong  = prevMid * (1 - prevMidOffsetPct)
prevMidShort = prevMid * (1 + prevMidOffsetPct)
tpLongFixed  = na(firstEntryPx) ? na : firstEntryPx * (1 + tpFixedPct)
tpShortFixed = na(firstEntryPx) ? na : firstEntryPx * (1 - tpFixedPct)

// Smart TP: only adapts AFTER a DCA leg fills (filledCount > 1). Before
// DCA, the trade rides to prev_mid (the structural mean-reversion target —
// the whole point of the strategy). Once DCA fires (price moved against
// us), avg entry shifts to a worse level, so we add a "% from avg entry"
// target and pick whichever of {prev_mid, avg × (1 ∓ smartTpPct)} is
// CLOSER to current price (easier to hit).
//   For LONG: TP must be ABOVE mark, so easier = LOWER value → math.min
//   For SHORT: TP must be BELOW mark, so easier = HIGHER value → math.max
// Without this guard, a no-DCA L1 short at prev_H would scalp 0.5% instead
// of riding the full 1-2% to prev_mid, giving up most of the strategy edge.
tpLongAvgPct  = na(avgEntryPx) ? na : avgEntryPx * (1 + smartTpPct)
tpShortAvgPct = na(avgEntryPx) ? na : avgEntryPx * (1 - smartTpPct)
tpLongSmart   = (filledCount > 1 and not na(tpLongAvgPct))  ? math.min(prevMidLong,  tpLongAvgPct)  : prevMidLong
tpShortSmart  = (filledCount > 1 and not na(tpShortAvgPct)) ? math.max(prevMidShort, tpShortAvgPct) : prevMidShort

// Hybrid TP: prev_mid until DCA fires, then switch to fixed % from FIRST
// entry. Reasoning — pre-DCA, the trade is on a small leg and prev_mid is
// usually within reach; post-DCA, avg entry has shifted away from prev_mid
// so a fixed-% target from first entry (e.g., 4%) often lets the winner
// run further than prev_mid would. Uses the existing tpFixedPct param.
tpLongHybrid  = (filledCount > 1 and not na(tpLongFixed))  ? tpLongFixed  : prevMidLong
tpShortHybrid = (filledCount > 1 and not na(tpShortFixed)) ? tpShortFixed : prevMidShort

tpLongPx  = tpMode == "smart" ? tpLongSmart
         : tpMode == "hybrid" ? tpLongHybrid
         : tpMode == "prev_mid" ? prevMidLong
         : tpMode == "prev_extreme" ? prevH
         : tpLongFixed
tpShortPx = tpMode == "smart" ? tpShortSmart
         : tpMode == "hybrid" ? tpShortHybrid
         : tpMode == "prev_mid" ? prevMidShort
         : tpMode == "prev_extreme" ? prevL
         : tpShortFixed

// Breakeven activation: once favorable% from FIRST entry exceeds the
// trigger, lock SL to firstEntry ± buffer for the rest of this cycle.
// Once activated stays active until the cycle resets — so a subsequent
// reversal can only exit at BE, not back at the worst-entry SL.
if useBreakeven and not beActivated and not na(firstEntryPx) and strategy.position_size != 0
    favLong  = (close - firstEntryPx) / firstEntryPx
    favShort = (firstEntryPx - close) / firstEntryPx
    if (strategy.position_size > 0 and favLong  >= breakevenTriggerPct) or (strategy.position_size < 0 and favShort >= breakevenTriggerPct)
        beActivated := true

// Post-DCA trail tracking. Once DCA fills (filledCount > 1), update the
// peak favorable price each bar — lowest low for shorts, highest high for
// longs. Monotonic in the favorable direction.
if usePostDcaTrail and filledCount > 1 and strategy.position_size != 0
    if strategy.position_size > 0
        peakFavPx := math.max(na(peakFavPx) ? high : peakFavPx, high)
    else
        peakFavPx := math.min(na(peakFavPx) ? low  : peakFavPx, low)

// SL composition. Start with raw (worst entry × (1 ∓ slBelowWorst)). BE
// can tighten to firstEntry ± buffer. Trail can tighten to peakFavPx ± offset.
// When multiple are armed, take the TIGHTEST (highest for long, lowest for short).
slLongPxRaw   = worstEntryPx * (1 - slBelowWorst)
slShortPxRaw  = worstEntryPx * (1 + slBelowWorst)
slLongPxBE    = na(firstEntryPx) ? na : firstEntryPx * (1 + breakevenBufferPct)
slShortPxBE   = na(firstEntryPx) ? na : firstEntryPx * (1 - breakevenBufferPct)
slLongPxTrail  = na(peakFavPx) ? na : peakFavPx * (1 - postDcaTrailOffset)
slShortPxTrail = na(peakFavPx) ? na : peakFavPx * (1 + postDcaTrailOffset)

slLongCandidate  = slLongPxRaw
slShortCandidate = slShortPxRaw
if useBreakeven and beActivated and not na(slLongPxBE)
    slLongCandidate  := math.max(slLongCandidate,  slLongPxBE)
    slShortCandidate := math.min(slShortCandidate, slShortPxBE)
if usePostDcaTrail and filledCount > 1 and not na(slLongPxTrail)
    slLongCandidate  := math.max(slLongCandidate,  slLongPxTrail)
    slShortCandidate := math.min(slShortCandidate, slShortPxTrail)
slLongPx  = slLongCandidate
slShortPx = slShortCandidate

if strategy.position_size > 0 and not na(worstEntryPx)
    // Exit all long legs at TP=prevMid or SL=2% below worst entry
    strategy.exit("xL1", from_entry="L1", limit=tpLongPx, stop=slLongPx)
    if filledCount >= 2
        strategy.exit("xL2", from_entry="L2", limit=tpLongPx, stop=slLongPx)
    if filledCount >= 3
        strategy.exit("xL3", from_entry="L3", limit=tpLongPx, stop=slLongPx)

if strategy.position_size < 0 and not na(worstEntryPx)
    strategy.exit("xS1", from_entry="S1", limit=tpShortPx, stop=slShortPx)
    if filledCount >= 2
        strategy.exit("xS2", from_entry="S2", limit=tpShortPx, stop=slShortPx)
    if filledCount >= 3
        strategy.exit("xS3", from_entry="S3", limit=tpShortPx, stop=slShortPx)

// ─── EOD flatten (optional) ───
if useEodFlatten and utcH >= closeHour and strategy.position_size != 0
    strategy.close_all(comment="EOD flatten")

// ─── Cycle reset after exit ───
// Increment cycles. Block further entries today only if (a) we've hit the
// per-day cap, or (b) EOD flatten just fired. Otherwise leave the door open
// for the standard L1 touch block to re-fire on a fresh prev_H/prev_L touch.
if strategy.position_size == 0 and strategy.position_size[1] != 0
    cyclesToday := cyclesToday + 1
    eodForced = useEodFlatten and utcH >= closeHour
    if cyclesToday >= maxCyclesPerDay or eodForced
        cycleClosedOnDay := dayofmonth
    filledCount     := 0
    firstEntryPx    := na
    worstEntryPx    := na
    cumNotional     := na
    cumQty          := na
    beActivated     := false
    peakFavPx       := na

// ─── Visuals ───
plot(prevH, "Prev H",   color=color.new(color.red,   50), style=plot.style_linebr)
plot(prevL, "Prev L",   color=color.new(color.green, 50), style=plot.style_linebr)
plot(prevMid, "Prev Mid (TP)", color=color.new(color.aqua, 30), style=plot.style_linebr)
plot(strategy.position_size != 0 and not na(worstEntryPx)
     ? (strategy.position_size > 0 ? slLongPx : slShortPx) : na,
     "Active SL", color=color.new(color.red, 20), style=plot.style_linebr, linewidth=2)

// Active TP — shows where TP currently sits (moves with smart mode after DCA)
plot(strategy.position_size != 0 and not na(firstEntryPx)
     ? (strategy.position_size > 0 ? tpLongPx : tpShortPx) : na,
     "Active TP", color=color.new(color.aqua, 0), style=plot.style_linebr, linewidth=2)

// Avg entry — shows where the cycle's weighted avg entry sits (smart-TP anchor)
plot(strategy.position_size != 0 and not na(avgEntryPx) ? avgEntryPx : na,
     "Avg Entry", color=color.new(color.yellow, 30), style=plot.style_linebr, linewidth=1)

// 1h EMA plotted on chart for visual bias reference
plot(hourEma, "1h EMA", color=color.new(color.purple, 20), linewidth=2)

plotshape(l1LongOk,  "L1",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(l1ShortOk, "S1",  shape.triangledown, location.abovebar, color.red,   size=size.small)

// Divergence markers — diamonds at the pivot bar where divergence fires
plotshape(useRsiDivergence and bullishDivFired, "Bull div", shape.diamond, location.belowbar, color.lime,   size=size.tiny, offset=-divPivotR)
plotshape(useRsiDivergence and bearishDivFired, "Bear div", shape.diamond, location.abovebar, color.orange, size=size.tiny, offset=-divPivotR)

wrongTf = timeframe.period != "5"
if barstate.islast and wrongTf
    var table tfWarn = table.new(position.bottom_center, 1, 1, border_width=2, border_color=color.red)
    table.cell(tfWarn, 0, 0,
         "⚠ Chart TF is " + timeframe.period + " — designed for 5m",
         bgcolor=color.new(color.red, 15), text_color=color.white, text_size=size.normal)

// Dashboard
if barstate.islast
    var table dash = table.new(position.top_right, 2, 13, border_width=1)
    table.cell(dash, 0, 0, "S/R DCA Day", bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 0, "5m", bgcolor=color.teal, text_color=color.white)
    table.cell(dash, 0, 1, "EOD")
    table.cell(dash, 1, 1, useEodFlatten ? str.tostring(closeHour) + ":00 UTC" : "OFF", text_color=useEodFlatten ? color.green : color.gray)
    table.cell(dash, 0, 2, "Prev H / L / Mid")
    table.cell(dash, 1, 2, str.tostring(prevL, "#.##") + " / " + str.tostring(prevMid, "#.##") + " / " + str.tostring(prevH, "#.##") + "  (" + str.tostring(activeLookback) + "d, " + str.tostring(prevRangePct*100, "#.##") + "%)")
    table.cell(dash, 0, 3, "UTC hour")
    table.cell(dash, 1, 3, str.tostring(utcH) + ":00")
    table.cell(dash, 0, 4, "TP mode")
    table.cell(dash, 1, 4, tpMode + (tpMode == "fixed_pct" or tpMode == "hybrid" ? " " + str.tostring(tpFixedPct*100, "#.#") + "%" : tpMode == "smart" ? " " + str.tostring(smartTpPct*100, "#.#") + "%" : ""))
    table.cell(dash, 0, 5, "Filled")
    table.cell(dash, 1, 5, str.tostring(filledCount) + "/" + str.tostring(dcaLevels))
    table.cell(dash, 0, 6, "Position")
    table.cell(dash, 1, 6, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray)
    table.cell(dash, 0, 7, "Avg entry")
    table.cell(dash, 1, 7, na(avgEntryPx) ? "—" : str.tostring(avgEntryPx, "#.##"))
    table.cell(dash, 0, 8, "Worst entry")
    table.cell(dash, 1, 8, na(worstEntryPx) ? "—" : str.tostring(worstEntryPx, "#.##"))
    table.cell(dash, 0, 9, "Active TP / SL src")
    tpStr  = strategy.position_size == 0 ? "—" : str.tostring(strategy.position_size > 0 ? tpLongPx : tpShortPx, "#.##")
    slSrc  = strategy.position_size == 0 ? "" : (useBreakeven and beActivated ? "  [BE]" : "")
    table.cell(dash, 1, 9, tpStr + slSrc, text_color=(useBreakeven and beActivated) ? color.yellow : color.aqua)
    table.cell(dash, 0, 10, "Cycles today")
    table.cell(dash, 1, 10, str.tostring(cyclesToday) + "/" + str.tostring(maxCyclesPerDay) + (cycleDone ? " (done)" : ""))
    bearAge = barsSinceBearDiv > divFreshBars ? "—" : str.tostring(barsSinceBearDiv) + "b"
    bullAge = barsSinceBullDiv > divFreshBars ? "—" : str.tostring(barsSinceBullDiv) + "b"
    table.cell(dash, 0, 11, "RSI div (bear/bull)")
    table.cell(dash, 1, 11, useRsiDivergence ? bearAge + " / " + bullAge : "OFF",
         text_color=useRsiDivergence ? color.aqua : color.gray)
    table.cell(dash, 0, 12, "Equity")
    table.cell(dash, 1, 12, "$" + str.tostring(strategy.equity, "#,###"))
