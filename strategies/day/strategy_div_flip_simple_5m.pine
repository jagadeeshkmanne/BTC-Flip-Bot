//@version=6
// ─────────────────────────────────────────────────────────────────────
// Divergence-Flip LIVE (5m) — Mirrors GCP paper bot config
//
// TV-tuned config (+189.83% / 10.86% DD / 138 trades / 97.83% WR / PF 109
// / Calmar 17.5, Apr 6 – May 14 2026). Mixed-shape 3:4:1.5 weights L2,
// RSI 10 + pivot R=1 catches reversals one bar after the low, RSI level
// filter 50/66, flip OFF, fixed TP 1% from avg + wide 5% L1 SL.
//
// ⚠ DESIGNED FOR: BTCUSDT perpetual · 5-minute timeframe · ONLY.
//
// ─── Logic ───
//   • Entry: fresh bull/bear div (≤21 bars) + RSI level filter at pivot
//            (50 / 70 — loose bull, strict bear). Pivot 5L/2R = fires
//            10 min after the low instead of 25. Immediate market entry.
//   • DCA: 3 levels @ 0.35% spacing, mixed-shape qty (3:4:1.5 → L1=35.3%, L2=47.1%, L3=17.6%)
//   • SL: 5% from L1 (bounded — DCA never widens SL; wide so trail/TP exit first)
//   • TP: 1% from avg entry (ON — primary exit, fires before trail in most trades)
//   • BE + Trailing (3Commas-style — backstop if TP doesn't hit):
//       - Arms at +0.55% favorable from L1
//       - Floor: firstEntry ± 0.2%
//       - Trail: peak ± 0.2%
//   • Flip: OFF (trades ride to TP/SL/trail, no mid-position whipsaws)
//   • No EOD, no time cap
// ─────────────────────────────────────────────────────────────────────

strategy("Divergence-Flip LIVE - 3 DCA Martingale (5m)", overlay=true, initial_capital=5000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=95,
     pyramiding=3, calc_on_order_fills=false, calc_on_every_tick=false,
     process_orders_on_close=true, commission_type=strategy.commission.percent,
     commission_value=0.04, slippage=3,
     margin_long=0, margin_short=0)

// ─── Risk ───
grpRisk = "⚙️ Risk"
leverageInput = input.float(3.0, "Leverage cap", minval=1, maxval=10, step=0.5, group=grpRisk)

// ─── DCA (matches bot: 3 levels @ 0.35% mixed-shape 3:4:1.5) ───
grpDCA = "📊 DCA (mixed-shape)"
dcaLevels  = input.int(3, "DCA levels", minval=1, maxval=3, group=grpDCA)
dcaSpacing = input.float(0.35, "DCA spacing (%)", minval=0.1, maxval=2.0, step=0.05, group=grpDCA,
     tooltip="Each leg fires at worst_entry × (1 ∓ this%). 0.35% matches bot — wider than 0.3% so DCA fires on deeper dips, better fill prices.") / 100
martRatio1 = input.float(3.0, "L1 qty ratio", minval=0.1, maxval=10, step=0.5, group=grpDCA)
martRatio2 = input.float(4.0, "L2 qty ratio", minval=0.1, maxval=10, step=0.5, group=grpDCA)
martRatio3 = input.float(1.5, "L3 qty ratio", minval=0.1, maxval=10, step=0.5, group=grpDCA,
     tooltip="3:4:1.5 = TV-tuned (L1=35.3%, L2=47.1%, L3=17.6% of leverage cap). Mixed shape — L2 (middle leg) gets the largest weight, L3 is small enough to keep worst-case loss bounded. Produced the +189.83% / 10.86% DD / 138 trades / Calmar 17.5 result.")

// ─── Stop Loss (L1-anchored — matches bot) ───
grpSL = "🛡️ Stop Loss"
slFromL1 = input.float(5.0, "SL % from L1 (first entry)", minval=0.5, maxval=10.0, step=0.1, group=grpSL,
     tooltip="L1-anchored: SL = firstEntry × (1∓this%). DCA only improves avg, never widens SL. TV-tuned: 5% — wide hard backstop so the 1% TP and 0.2% trail fire first; SL only triggers on a real adverse run.") / 100

// ─── BE + Trailing (3Commas-style — matches bot) ───
grpBE = "🎯 BE + Trailing SL"
useBE        = input.bool(true, "Enable BE + trailing", group=grpBE)
beTrigger    = input.float(0.55, "BE arms at +fav from L1 (%)", minval=0.1, maxval=3.0, step=0.05, group=grpBE,
     tooltip="Once +0.55% favorable from L1, BE arms and trailing SL kicks in. TV-tuned: 0.55%.") / 100
beBuffer     = input.float(0.2, "BE floor buffer (%)", minval=0.0, maxval=1.0, step=0.05, group=grpBE,
     tooltip="After BE arms, SL has hard floor at firstEntry ± this%. Bot: 0.2%.") / 100
trailDistPct = input.float(0.2, "Trail distance from peak (%)", minval=0.05, maxval=2.0, step=0.05, group=grpBE,
     tooltip="After BE arms, SL also trails peak (LONG) / trough (SHORT) by this. Bot: 0.2%.") / 100

// ─── Optional Take Profit (default OFF — bot exits via trailing only) ───
grpTP = "🎯 Take Profit (optional)"
useTakeProfit = input.bool(true, "Enable fixed TP from avg entry", group=grpTP,
     tooltip="TV-tuned: ON. Primary exit. Trailing SL is the backstop if price never reaches TP. 1% from avg entry hits frequently → 99% WR over 105 trades.")
tpPct = input.float(1.0, "TP % from avg entry", minval=0.1, maxval=5.0, step=0.05, group=grpTP) / 100

// ─── RSI Divergence ───
grpDiv = "📉 RSI Divergence"
rsiPeriod    = input.int(10, "RSI period",       minval=5, maxval=30, group=grpDiv,
     tooltip="TV-tuned: 10 (faster than Wilder's 14 — more pivots qualify the ≤50/≥66 level filter, ~15% more trades).")
divPivotL    = input.int(5,  "Pivot left bars",  minval=1, maxval=10, group=grpDiv)
divPivotR    = input.int(1,  "Pivot right bars", minval=1, maxval=10, group=grpDiv,
     tooltip="TV-tuned: 1 (fires 5 min after the low — fastest setting). Loosest pivot filter, catches the most reversal setups.")
divFreshBars = input.int(21, "Divergence valid for N bars", minval=1, maxval=50, group=grpDiv,
     tooltip="21 bars = 105 min on 5m.")

// ─── RSI Level Filter (40/60 = user override; bot uses 30/70) ───
grpQuality = "🎯 RSI Level Filter"
useRsiLevelFilter = input.bool(true, "Filter by RSI level at pivot", group=grpQuality,
     tooltip="Reject divs where RSI at pivot wasn't past the threshold. Cuts mid-range fakeouts.")
rsiLongMax  = input.float(50, "Bull div: max RSI at pivot", minval=20, maxval=50, step=1, group=grpQuality,
     tooltip="TV-tuned: 50 (loose — catches almost all bull divs). Asymmetric with strict 70 bear filter creates a long-bias.")
rsiShortMin = input.float(66, "Bear div: min RSI at pivot", minval=50, maxval=80, step=1, group=grpQuality,
     tooltip="TV-tuned: 66 (was 70 — looser bear catches +14 more trades / +38% return at modest DD cost). Less strict than 70 but still filters out mid-range bear divs.")

// ─── Flip (TV-tuned: OFF — trades ride to SL/trail) ───
useFlip = input.bool(false, "Close + reverse on opposite divergence", group="🔄 Flip",
     tooltip="OFF in TV-tuned config — lets trades ride to SL/trail instead of bouncing sides on every opposite div. Mid-position whipsaws cost more than they save.")

// ═════ Indicators ═════
rsiVal = ta.rsi(close, rsiPeriod)

priceHiPivot = ta.pivothigh(high, divPivotL, divPivotR)
priceLoPivot = ta.pivotlow(low,  divPivotL, divPivotR)

var float lastPHigh = na
var float prevPHigh = na
var float lastRAtH  = na
var float prevRAtH  = na
var float lastPLow  = na
var float prevPLow  = na
var float lastRAtL  = na
var float prevRAtL  = na

if not na(priceHiPivot)
    prevPHigh := lastPHigh
    prevRAtH  := lastRAtH
    lastPHigh := priceHiPivot
    lastRAtH  := rsiVal[divPivotR]

if not na(priceLoPivot)
    prevPLow := lastPLow
    prevRAtL := lastRAtL
    lastPLow := priceLoPivot
    lastRAtL := rsiVal[divPivotR]

bearishDivFired = not na(prevPHigh) and not na(priceHiPivot) and lastPHigh > prevPHigh and lastRAtH < prevRAtH
bullishDivFired = not na(prevPLow)  and not na(priceLoPivot) and lastPLow  < prevPLow  and lastRAtL > prevRAtL

var int barsSinceBearDiv = 9999
var int barsSinceBullDiv = 9999
var float rsiAtLastBullPivot = na
var float rsiAtLastBearPivot = na
barsSinceBearDiv := bearishDivFired ? 0 : barsSinceBearDiv + 1
barsSinceBullDiv := bullishDivFired ? 0 : barsSinceBullDiv + 1
if bullishDivFired
    rsiAtLastBullPivot := lastRAtL
if bearishDivFired
    rsiAtLastBearPivot := lastRAtH

// RSI level filter at pivot
rsiBullOk = not useRsiLevelFilter or (not na(rsiAtLastBullPivot) and rsiAtLastBullPivot <= rsiLongMax)
rsiBearOk = not useRsiLevelFilter or (not na(rsiAtLastBearPivot) and rsiAtLastBearPivot >= rsiShortMin)

bullDivOk = barsSinceBullDiv <= divFreshBars and rsiBullOk
bearDivOk = barsSinceBearDiv <= divFreshBars and rsiBearOk

// ═════ State ═════
var float firstEntryPx       = na
var float worstEntryPx       = na
var int   filledCount        = 0
var float cumNotional        = na
var float cumQty             = na
var bool  beActivated        = false
var float peakPriceLong      = na
var float troughPriceShort   = na
var float qtyL1Stored        = na
var float qtyL2Stored        = na
var float qtyL3Stored        = na

avgEntryPx = na(cumQty) or cumQty == 0 ? na : cumNotional / cumQty

// ─── Martingale-weighted per-leg qty (computed at L1 entry) ───
totalRatio  = martRatio1 + martRatio2 + martRatio3
totalCapQty = strategy.equity * 0.95 * leverageInput / close

// ─── L1 entry (immediate market on confirm bar — matches bot) ───
l1LongTrigger  = strategy.position_size == 0 and bullDivOk and na(firstEntryPx)
l1ShortTrigger = strategy.position_size == 0 and bearDivOk and na(firstEntryPx)

if l1LongTrigger
    qtyL1Stored := totalCapQty * martRatio1 / totalRatio
    qtyL2Stored := totalCapQty * martRatio2 / totalRatio
    qtyL3Stored := totalCapQty * martRatio3 / totalRatio
    if qtyL1Stored > 0
        strategy.entry("L1", strategy.long, qty=qtyL1Stored)
        firstEntryPx     := close
        worstEntryPx     := close
        cumNotional      := close * qtyL1Stored
        cumQty           := qtyL1Stored
        filledCount      := 1
        beActivated      := false
        peakPriceLong    := high

if l1ShortTrigger
    qtyL1Stored := totalCapQty * martRatio1 / totalRatio
    qtyL2Stored := totalCapQty * martRatio2 / totalRatio
    qtyL3Stored := totalCapQty * martRatio3 / totalRatio
    if qtyL1Stored > 0
        strategy.entry("S1", strategy.short, qty=qtyL1Stored)
        firstEntryPx     := close
        worstEntryPx     := close
        cumNotional      := close * qtyL1Stored
        cumQty           := qtyL1Stored
        filledCount      := 1
        beActivated      := false
        troughPriceShort := low

// ─── DCA fills (fixed 0.3% spacing, martingale qty from stored ratios) ───
if strategy.position_size > 0 and filledCount >= 1 and filledCount < dcaLevels
    nextDcaPx = worstEntryPx * (1 - dcaSpacing)
    if low <= nextDcaPx
        idStr   = "L" + str.tostring(filledCount + 1)
        nextQty = filledCount == 1 ? qtyL2Stored : qtyL3Stored
        strategy.entry(idStr, strategy.long, qty=nextQty, limit=nextDcaPx)
        worstEntryPx := nextDcaPx
        cumNotional  := cumNotional + nextDcaPx * nextQty
        cumQty       := cumQty + nextQty
        filledCount  := filledCount + 1

if strategy.position_size < 0 and filledCount >= 1 and filledCount < dcaLevels
    nextDcaPx = worstEntryPx * (1 + dcaSpacing)
    if high >= nextDcaPx
        idStr   = "S" + str.tostring(filledCount + 1)
        nextQty = filledCount == 1 ? qtyL2Stored : qtyL3Stored
        strategy.entry(idStr, strategy.short, qty=nextQty, limit=nextDcaPx)
        worstEntryPx := nextDcaPx
        cumNotional  := cumNotional + nextDcaPx * nextQty
        cumQty       := cumQty + nextQty
        filledCount  := filledCount + 1

// ─── Track peak/trough for trailing SL ───
if strategy.position_size > 0 and not na(firstEntryPx)
    peakPriceLong := na(peakPriceLong) ? high : math.max(peakPriceLong, high)

if strategy.position_size < 0 and not na(firstEntryPx)
    troughPriceShort := na(troughPriceShort) ? low : math.min(troughPriceShort, low)

// ─── BE activation ───
if useBE and not beActivated and not na(firstEntryPx) and strategy.position_size != 0
    favLong  = (close - firstEntryPx) / firstEntryPx
    favShort = (firstEntryPx - close) / firstEntryPx
    if (strategy.position_size > 0 and favLong  >= beTrigger) or (strategy.position_size < 0 and favShort >= beTrigger)
        beActivated := true

// ─── SL — L1-anchored, with BE floor + trailing peak after BE armed ───
slLongRaw    = na(firstEntryPx)     ? na : firstEntryPx     * (1 - slFromL1)
slShortRaw   = na(firstEntryPx)     ? na : firstEntryPx     * (1 + slFromL1)
slLongBE     = na(firstEntryPx)     ? na : firstEntryPx     * (1 + beBuffer)
slShortBE    = na(firstEntryPx)     ? na : firstEntryPx     * (1 - beBuffer)
slLongTrail  = na(peakPriceLong)    ? na : peakPriceLong    * (1 - trailDistPct)
slShortTrail = na(troughPriceShort) ? na : troughPriceShort * (1 + trailDistPct)

slLongPx  = useBE and beActivated ? math.max(slLongRaw, slLongBE, slLongTrail)  : slLongRaw
slShortPx = useBE and beActivated ? math.min(slShortRaw, slShortBE, slShortTrail) : slShortRaw

// ─── TP (optional — disabled by default to match bot) ───
tpLongPx  = useTakeProfit and not na(avgEntryPx) ? avgEntryPx * (1 + tpPct) : na
tpShortPx = useTakeProfit and not na(avgEntryPx) ? avgEntryPx * (1 - tpPct) : na

// ─── Exit orders ───
if strategy.position_size > 0 and not na(slLongPx)
    strategy.exit("xL1", from_entry="L1", limit=tpLongPx, stop=slLongPx)
    if filledCount >= 2
        strategy.exit("xL2", from_entry="L2", limit=tpLongPx, stop=slLongPx)
    if filledCount >= 3
        strategy.exit("xL3", from_entry="L3", limit=tpLongPx, stop=slLongPx)

if strategy.position_size < 0 and not na(slShortPx)
    strategy.exit("xS1", from_entry="S1", limit=tpShortPx, stop=slShortPx)
    if filledCount >= 2
        strategy.exit("xS2", from_entry="S2", limit=tpShortPx, stop=slShortPx)
    if filledCount >= 3
        strategy.exit("xS3", from_entry="S3", limit=tpShortPx, stop=slShortPx)

// ─── Flip on opposite divergence ───
if useFlip and strategy.position_size != 0
    if strategy.position_size > 0 and bearDivOk
        strategy.close_all(comment="FLIP→SHORT")
    if strategy.position_size < 0 and bullDivOk
        strategy.close_all(comment="FLIP→LONG")

// ─── Cycle reset ───
if strategy.position_size == 0 and strategy.position_size[1] != 0
    filledCount      := 0
    firstEntryPx     := na
    worstEntryPx     := na
    cumNotional      := na
    cumQty           := na
    beActivated      := false
    peakPriceLong    := na
    troughPriceShort := na
    qtyL1Stored      := na
    qtyL2Stored      := na
    qtyL3Stored      := na

// ═════ Visuals ═════
plot(strategy.position_size != 0 and not na(tpLongPx)  ? (strategy.position_size > 0 ? tpLongPx  : tpShortPx)  : na,
     "Active TP", color=color.new(color.aqua, 0), style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 and not na(slLongPx)  ? (strategy.position_size > 0 ? slLongPx  : slShortPx)  : na,
     "Active SL", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 and not na(avgEntryPx) ? avgEntryPx : na,
     "Avg Entry", color=color.new(color.yellow, 30), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size > 0 and beActivated and not na(peakPriceLong) ? peakPriceLong : strategy.position_size < 0 and beActivated and not na(troughPriceShort) ? troughPriceShort : na,
     "Peak/Trough", color=color.new(#FFD700, 0), style=plot.style_linebr, linewidth=1)

plotshape(bullDivOk and barsSinceBullDiv == 0, "Bull div", shape.diamond, location.belowbar, color.lime,   size=size.tiny, offset=-divPivotR)
plotshape(bearDivOk and barsSinceBearDiv == 0, "Bear div", shape.diamond, location.abovebar, color.orange, size=size.tiny, offset=-divPivotR)

if barstate.islast and timeframe.period != "5"
    var table tfWarn = table.new(position.bottom_center, 1, 1, border_width=2, border_color=color.red)
    table.cell(tfWarn, 0, 0,
         "⚠ Chart TF is " + timeframe.period + " — designed for 5m",
         bgcolor=color.new(color.red, 15), text_color=color.white, text_size=size.normal)

// Dashboard
if barstate.islast
    var table dash = table.new(position.top_right, 2, 10, border_width=1)
    table.cell(dash, 0, 0, "Div-Flip LIVE", bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 0, "5m · 3 DCA mart", bgcolor=color.teal, text_color=color.white)
    table.cell(dash, 0, 1, "RSI now")
    table.cell(dash, 1, 1, str.tostring(rsiVal, "#.#"))
    bullAge = barsSinceBullDiv > 50 ? "—" : str.tostring(barsSinceBullDiv) + "b"
    bearAge = barsSinceBearDiv > 50 ? "—" : str.tostring(barsSinceBearDiv) + "b"
    table.cell(dash, 0, 2, "Bull / Bear age")
    table.cell(dash, 1, 2, bullAge + " / " + bearAge,
         text_color=(bullDivOk or bearDivOk) ? color.aqua : color.gray)
    table.cell(dash, 0, 3, "Position")
    table.cell(dash, 1, 3, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray)
    table.cell(dash, 0, 4, "Avg entry")
    table.cell(dash, 1, 4, na(avgEntryPx) ? "—" : str.tostring(avgEntryPx, "#.##"))
    table.cell(dash, 0, 5, "Worst entry")
    table.cell(dash, 1, 5, na(worstEntryPx) ? "—" : str.tostring(worstEntryPx, "#.##"))
    table.cell(dash, 0, 6, "Active SL")
    slDisp = strategy.position_size == 0 ? "—" : str.tostring(strategy.position_size > 0 ? slLongPx : slShortPx, "#.##")
    table.cell(dash, 1, 6, slDisp + (useBE and beActivated ? " [BE+Trail]" : ""),
         text_color=beActivated ? color.new(#FFD700, 0) : color.red)
    table.cell(dash, 0, 7, "Filled")
    table.cell(dash, 1, 7, str.tostring(filledCount) + "/" + str.tostring(dcaLevels))
    table.cell(dash, 0, 8, "Peak / Trough")
    peakDisp = strategy.position_size > 0 and not na(peakPriceLong) ? str.tostring(peakPriceLong, "#.##") : strategy.position_size < 0 and not na(troughPriceShort) ? str.tostring(troughPriceShort, "#.##") : "—"
    table.cell(dash, 1, 8, peakDisp,
         text_color=beActivated ? color.new(#FFD700, 0) : color.gray)
    table.cell(dash, 0, 9, "Equity")
    table.cell(dash, 1, 9, "$" + str.tostring(strategy.equity, "#,###"))
